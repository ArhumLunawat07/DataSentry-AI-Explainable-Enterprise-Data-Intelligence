# Gemini API Key (configured in AI Studio Secrets panel)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# IBM Db2 Enterprise Connection Details
DB2_DATABASE=BLUDB
DB2_HOSTNAME=db2w-your-instance.databases.appdomain.cloud
DB2_PORT=32551
DB2_PROTOCOL=TCPIP
DB2_UID=db2admin
DB2_PWD=YOUR_DB2_PASSWORD
DB2_SECURITY=SSL
DB2_SCHEMA=DATASENTRY

# Server Configuration
PORT=4000
NODE_ENV=production
